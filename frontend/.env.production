# Public build settings for production (vinext build / Cloudflare Workers).
# Every NEXT_PUBLIC_ value ends up in the browser bundle, so nothing here is secret.
# NEXT_PUBLIC_AUCTION_DEMO must stay unset: a production build (PANORAMA_PRODUCTION=1,
# set by `pnpm run deploy`) fails if it is 1.
# Copied from the Vercel panorama-season-2-auction production settings.

NEXT_PUBLIC_AUCTION_DEPLOY_BLOCK=25545711
