NEXT_PUBLIC_CDN_BASE_URL=https://cdn.panorama.garden
NEXT_PUBLIC_CHAIN_ID=1
NEXT_PUBLIC_GITHUB_URL=https://github.com/ygtdmn/panorama-season-2-auction
NEXT_PUBLIC_PANORAMA_AUCTION_ADDRESS=0x902237C2B0A4B428eefEd862019D5FF0a6E509fd
NEXT_PUBLIC_PANORAMA_ERC20_ADDRESS=0x74B8174a862B098DB9A44E0C553A3bFa79EF602d
NEXT_PUBLIC_PANORAMA_NFT_ADDRESS=0x435BD9CF72C278c9bAD9655732a6724469c6D9Ff
NEXT_PUBLIC_RPC_URL=https://ethereum-rpc.publicnode.com
